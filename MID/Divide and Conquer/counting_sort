#include<bits/stdc++.h>
using namespace std;
#define ll long long 



const int MAX = 100;
int  main() {
  ios_base::sync_with_stdio(0);
  cin.tie(0);
  ll n; 
  cin >> n;
  vector<ll> cnt(MAX + 1, 0);
  for (ll i = 1; i <= n; i++) {
    ll x; cin >> x;
    cnt[x]++;
  }
  for (ll i = 0; i <= MAX; i++) {
    while (cnt[i] > 0) {
      cout << i << ' ';
      cnt[i]--;
    }
  }
  cout << '\n';
  return 0;
}
